{
  "name": "@portabletext/vue",
  "version": "2.0.0",
  "description": "Render Portable Text with Vue",
  "keywords": [
    "portable-text",
    "vue"
  ],
  "homepage": "https://github.com/portabletext/vue-portabletext#readme",
  "bugs": {
    "url": "https://github.com/portabletext/vue-portabletext/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/portabletext/vue-portabletext.git"
  },
  "license": "MIT",
  "author": "Rupert Dunk <rupert@rupertdunk.com> (https://rupertdunk.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/vue-portable-text.d.ts",
      "default": "./dist/vue-portable-text.mjs"
    },
    "./*": "./*"
  },
  "main": "./dist/vue-portable-text.mjs",
  "types": "./dist/vue-portable-text.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "run-s clean pkg:build",
    "clean": "rimraf dist coverage .nyc_output",
    "format": "prettier --write --cache --ignore-unknown .",
    "pkg:build": "vite build",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run clean",
    "release": "changeset publish",
    "test": "vitest"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson"
    ],
    "printWidth": 100,
    "semi": true,
    "singleQuote": true
  },
  "dependencies": {
    "@portabletext/toolkit": "^6.1.1",
    "@portabletext/types": "^4.0.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-extractor": "^7.60.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/compiler-sfc": "^3.5.46",
    "@vue/language-core": "^3.3.14",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.1.0",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "rimraf": "^6.1.4",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.2",
    "vue": "^3.5.46"
  },
  "peerDependencies": {
    "vue": "^3.3.4"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
